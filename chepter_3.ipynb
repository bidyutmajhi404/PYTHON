    "### 51:Reverse a string without using `reversed()` and print the result.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "36cabfff-214a-4b4f-8240-b39d856f5d4e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# use \n",
    "s = \"hello\"\n",
    "reversed_s = \"\"\n",
    "\n",
    "for ch in s:\n",
    "    reversed_s = ch + reversed_s\n",
    "\n",
    "print(reversed_s)"
   ]
